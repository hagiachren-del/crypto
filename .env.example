# Copy to .env. Never commit .env.

# Per-device bearer tokens: device_id:token pairs separated by commas.
# Leave empty to run open (the service logs a warning). Generate with: openssl rand -hex 24
ROUTER_TOKENS=iphone:replace-me,mac:replace-me-too,web:replace-me-three

# Used when a request carries no user_id (single-user household).
ROUTER_DEFAULT_USER=me

# Paths (defaults shown)
# ROUTER_ASSISTANTS_FILE=assistants.yaml
# ROUTER_CONFIG_FILE=config.yaml

# Provider keys, read by LiteLLM
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# OLLAMA_API_BASE=http://localhost:11434
